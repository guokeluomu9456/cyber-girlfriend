# ============================================
# Cyber Girlfriend - Environment Template
# ============================================
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control!
# ============================================

# --- iLink Bot (WeChat Integration) ---
ILINK_API_KEY=your_ilink_api_key_here
ILINK_BOT_ID=your_bot_id_here

# --- LLM Provider (choose one or more) ---
# MiniMax (default for this project)
MINIMAX_API_KEY=your_minimax_api_key_here

# OpenAI (alternative)
# OPENAI_API_KEY=your_openai_api_key_here

# Grok xAI (alternative)
# XAI_API_KEY=your_xai_api_key_here

# --- TTS Provider (optional) ---
# Edge TTS (free, no key required)
# TTS_PROVIDER=edge

# MiniMax TTS
# MINIMAX_TTS_KEY=your_minimax_tts_key_here